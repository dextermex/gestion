{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morada-gestion",
  "main": ".open-next/worker.js",
  "minify": true,
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Production hostname — the morada.lu zone lives on the same Cloudflare
  // account; custom_domain creates the DNS record and certificate.
  "routes": [{ "pattern": "app.morada.lu", "custom_domain": true }]
}
